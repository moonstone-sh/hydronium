-- Hydronium Ink example: a real, interactive todo list. Exercises
-- everything built across Phases 1-3 together in one realistic app,
-- not in isolation the way tests/host/terminal_spec.lua's specs do:
-- real Yoga flexbox layout (Box/Spacer), the full Text/Box style
-- surface (colors, bold, dimColor, inverse for the selected row, a
-- border), and real interactivity (useInput for navigation/editing,
-- useApp for a clean exit, useWindowSize for a responsive width).
--
-- Controls:
--   Up/Down    move the selection
--   Enter      toggle the selected task done/not-done
--   a          start typing a new task (Enter commits it, Escape cancels)
--   d          delete the selected task
--   q / Ctrl-C quit
--
-- Not directly runnable with `luajit` -- .luax is always compiled to
-- plain Lua first (see examples/ink_demo/run_luax.lua for the
-- established pattern this mirrors). Run via:
--
--   luajit examples/ink_todo/run.lua

local hydronium = require("hydronium")
local ink = require("hydronium_ink")
local hooks = require("hydronium_ink.hooks")

-- Real Ink's own Box/Text prop types (this repo's Tier 1 typed catalog --
-- see docs/LUAX_HOST_TYPE_AUTHORING.md) give real completion on every
-- <ink.Box .../<ink.Text ...> attribute below in an editor.

---@param tasks { text: string, done: boolean }[]
---@param selectedIndex integer
local function TaskList(tasks, selectedIndex)
  local rows = {}
  for i, task in ipairs(tasks) do
    local isSelected = i == selectedIndex
    local mark = task.done and "[x]" or "[ ]"
    table.insert(rows,
      <ink.Box key={i} flexDirection="row">
        <ink.Text color={isSelected and "cyan" or nil} bold={isSelected} inverse={isSelected}>
          {(isSelected and "> " or "  ") .. mark .. " "}
        </ink.Text>
        <ink.Text color={isSelected and "cyan" or nil}
          bold={isSelected}
          inverse={isSelected}
          dimColor={task.done}
          strikethrough={task.done}
        >
          {task.text}
        </ink.Text>
      </ink.Box>
    )
  end
  if #rows == 0 then
    return <ink.Text dimColor={true}>  No tasks yet -- press "a" to add one.</ink.Text>
  end
  return rows
end

return function()
  local tasks, setTasks = hydronium.signal({
    { text = "Write the Yoga FFI binding", done = true },
    { text = "Wire up real keyboard input", done = true },
    { text = "Ship a real example app", done = false },
  })
  local selectedIndex, setSelectedIndex = hydronium.signal(1)
  local mode, setMode = hydronium.signal("navigate") -- "navigate" | "insert"
  local draft, setDraft = hydronium.signal("")

  local exit = hooks.useApp().exit

  local function cloneTasks()
    local src, out = tasks(), {}
    for i, t in ipairs(src) do out[i] = { text = t.text, done = t.done } end
    return out
  end

  hooks.useInput(function(input, key)
    if mode() == "insert" then
      if key["return"] then
        local text = draft()
        if text ~= "" then
          local list = cloneTasks()
          table.insert(list, { text = text, done = false })
          setTasks(list)
        end
        setDraft("")
        setMode("navigate")
      elseif key.escape then
        setDraft("")
        setMode("navigate")
      elseif key.backspace or key.delete then
        local d = draft()
        setDraft(d:sub(1, #d - 1))
      elseif input ~= "" and not key.ctrl then
        setDraft(draft() .. input)
      end
      return
    end

    -- "navigate" mode
    local count = #tasks()
    if key.upArrow then
      setSelectedIndex(math.max(1, selectedIndex() - 1))
    elseif key.downArrow then
      setSelectedIndex(math.min(math.max(count, 1), selectedIndex() + 1))
    elseif key["return"] then
      local idx = selectedIndex()
      local list = cloneTasks()
      if list[idx] then
        list[idx].done = not list[idx].done
        setTasks(list)
      end
    elseif input == "a" then
      setMode("insert")
    elseif input == "d" then
      local idx = selectedIndex()
      local src, list = tasks(), {}
      for i, t in ipairs(src) do
        if i ~= idx then table.insert(list, t) end
      end
      setTasks(list)
      setSelectedIndex(math.max(1, math.min(idx, #list)))
    elseif input == "q" then
      exit()
    end
  end)

  return function()
    local size = hooks.useWindowSize()
    local width = math.max(math.min(size.columns, 50), 30)
    local list = tasks()
    local doneCount = 0
    for _, t in ipairs(list) do
      if t.done then doneCount = doneCount + 1 end
    end

    return <ink.Box flexDirection="column" width={width} borderStyle="single" paddingX={1}>
      <ink.Box flexDirection="row">
        <ink.Text bold={true} color="cyan">Hydronium Ink Todo</ink.Text>
        <ink.Spacer />
        <ink.Text dimColor={true}>{size.columns .. "x" .. size.rows}</ink.Text>
      </ink.Box>
      <ink.Newline />
      {TaskList(list, selectedIndex())}
      <ink.Newline />
      {mode() == "insert" and (
        <ink.Text>{"> " .. draft() .. "_"}</ink.Text>
      ) or (
        <ink.Text dimColor={true}>{doneCount .. "/" .. #list .. " done"}</ink.Text>
      )}
      <ink.Newline />
      <ink.Text dimColor={true}>
        {mode() == "insert" and "Enter: add   Esc: cancel" or "Up/Down: move   Enter: toggle   a: add   d: delete   q: quit"}
      </ink.Text>
    </ink.Box>
  end
end
