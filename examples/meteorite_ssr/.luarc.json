{
  "runtime": {
    "version": "LuaJIT",
    "plugin": "../../src/hydronium/luax/luals/init.lua"
  },
  "workspace": {
    "library": [
      "../../types",
      "../../ambient-types",
      "../../.moonstone/env/share/lua/5.4"
    ],
    "checkThirdParty": false,
    "useGitIgnore": false,
    "ignoreDir": [
      ".moonstone",
      ".zig-cache",
      ".meteorite",
      "dist",
      ".git"
    ]
  },
  "files.associations": {
    "*.luax": "lua"
  },
  "plugin": {
    "enable": true,
    "path": "../../src/hydronium/luax/luals/init.lua"
  },
  "diagnostics": {
    "globals": [
      "__luax",
      "__luax_component",
      "__luax_fragment"
    ]
  }
}
