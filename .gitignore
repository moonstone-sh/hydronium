# Moonstone
.moonstone/

# Zig
zig-cache/
.zig-cache/
zig-out/

# Meteorite build cache and compiled output
.meteorite/
examples/meteorite_ssr/dist/

# OS
.DS_Store

# Ballad run/export cache and packaging output
.ballad/
dist/
*.vsix
nvim.log

# JS (hydronium/js workspace -- @hydronium/dom-client, @hydronium/vite).
# NOTE: dom/src/hydronium_dom/client/ is intentionally NOT ignored here --
# it is a generated-but-committed copy (see js/scripts/sync-dom-client.mjs),
# committed so dom/'s moonstone package still ships its client JS without
# requiring node/npm at package time. See docs/HYDRONIUM_WEB_VITE_ADAPTER_PLAN.md.
node_modules/
js/**/.vite/

# Host-private generated metadata: @hydronium/vite's running dev-server
# descriptor (vite-dev.json, carries a bound port), Ballad's topology
# source-inventory artifacts, and `hydronium lab init`'s generated host.
# All are produced by a tool from checked-in declarations -- see
# PENDING_HMR.md ("Private generated inventory": the public site manifest
# is what ships, this tree never is).
.hydronium/
