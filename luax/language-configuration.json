{
  "comments": {
    "lineComment": "--",
    "blockComment": ["--[[", "]]"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "<", "close": ">", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["<", ">"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(else|elseif|do|then|repeat)\\b|^((?!--).)*(\\bfunction\\b(?!.+\\bend\\b)|\\bthen\\b|\\bdo\\b|\\brepeat\\b|\\{|\\(|<[a-zA-Z_][a-zA-Z0-9_\\-\\.]*(\\s+[^>]*)?>\\s*)$",
    "decreaseIndentPattern": "^\\s*(elseif|else|end|until|\\}|\\)|\\/>|<\\/[a-zA-Z_][a-zA-Z0-9_\\-\\.]*>)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*--#region\\b",
      "end": "^\\s*--#endregion\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
