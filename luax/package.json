{
  "name": "hydronium-luax",
  "displayName": "Hydronium LUAX",
  "description": "LUAX (.luax) and Hydronium MDX: highlighting, completion, hover and diagnostics through lua-language-server with Hydronium's plugin, tag auto-close and linked rename, and tag commands.",
  "version": "0.2.0",
  "publisher": "hydronium",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonstone-sh/hydronium",
    "directory": "luax"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "lua",
    "luax",
    "jsx",
    "hydronium",
    "mdx"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:luax",
    "workspaceContains:**/*.luax",
    "workspaceContains:**/*.mdx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "luax",
        "aliases": [
          "LUAX",
          "luax"
        ],
        "extensions": [
          ".luax"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "luax",
        "scopeName": "source.luax",
        "path": "./syntaxes/luax.tmLanguage.json"
      },
      {
        "path": "./syntaxes/luax.tmLanguage.json",
        "scopeName": "source.luax",
        "injectTo": [
          "source.lua"
        ]
      }
    ],
    "snippets": [
      {
        "language": "luax",
        "path": "./snippets/luax.json"
      }
    ],
    "commands": [
      {
        "command": "hydroniumLuax.renameTag",
        "title": "Rename Tag",
        "category": "LUAX"
      },
      {
        "command": "hydroniumLuax.removeTag",
        "title": "Remove Tag",
        "category": "LUAX"
      },
      {
        "command": "hydroniumLuax.unwrapTag",
        "title": "Unwrap Tag (keep children)",
        "category": "LUAX"
      },
      {
        "command": "hydroniumLuax.restartServer",
        "title": "Restart Language Server",
        "category": "LUAX"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "hydroniumLuax.renameTag",
          "when": "editorLangId == luax"
        },
        {
          "command": "hydroniumLuax.removeTag",
          "when": "editorLangId == luax"
        },
        {
          "command": "hydroniumLuax.unwrapTag",
          "when": "editorLangId == luax"
        }
      ]
    },
    "configuration": {
      "title": "Hydronium LUAX",
      "properties": {
        "hydroniumLuax.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `lua-language-server`. Empty: the one bundled with the Lua extension (`sumneko.lua`), then `PATH`."
        },
        "hydroniumLuax.autoCloseTags": {
          "type": "boolean",
          "default": true,
          "description": "Insert the closing tag when typing the > of an opening tag."
        }
      }
    },
    "configurationDefaults": {
      "[luax]": {
        "editor.linkedEditing": true
      },
      "emmet.includeLanguages": {
        "luax": "html"
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, lua-language-server asks before loading a LuaLS plugin."
    }
  }
}
