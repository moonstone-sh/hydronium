-- Default composition; every piece is independently available in components.
local H = require("hydronium")
local C = require("hydronium_lab.components")
local function slot(value, fallback)
  if value == false then return nil end
  if value ~= nil then return value end
  return fallback()
end
local function Shell(props)
  local common = { legacy_class_prefix=props.legacy_class_prefix }
  local function node(component, ...) return H.h(component, common, ...) end
  local root = {}
  for key, value in pairs(props.root_attributes or {}) do root[key] = value end
  root.class, root.style = props.class or root.class, props.style or root.style
  root.project_id, root.renderer = props.project_id, props.renderer
  root.layout = props.layout or "sidebar-right"
  if props.sidebar == false then root["data-sidebar-collapsed"] = "true" end
  root.legacy_class_prefix = props.legacy_class_prefix
  return H.h(C.Root, root,
    slot(props.canvas, function() return node(C.Canvas,
      slot(props.toolbar, function() return node(C.Toolbar,
        node(C.ActiveStory), node(C.Hud, props.renderer_controls, props.metrics,
          slot(props.canvas_actions, function() return node(C.CanvasActions, node(C.ZoomOut), node(C.ZoomIn), node(C.CenterCanvas), node(C.SidebarToggle)) end))) end),
      slot(props.stage, function() return H.h(C.Stage, { legacy_class_prefix=props.legacy_class_prefix, ["aria-label"]=props.canvas_label or "Preview canvas. Space drag pans; C centers; F toggles fullscreen; Control plus or minus zooms." },
        node(C.Viewport, slot(props.grid, function() return node(C.Grid) end), props.preview),
        slot(props.rulers, function() return node(C.Rulers) end),
        slot(props.guides, function() return node(C.Guides) end),
        slot(props.ruler_handle, function() return node(C.RulerHandle) end),
        slot(props.hints, function() return node(C.Hints, props.shortcut_legend or "Space drag · C center · R rulers · H hints · F fullscreen · Ctrl +/− zoom") end),
        slot(props.status, function() return node(C.Status, "Connecting") end)) end)) end),
    slot(props.sidebar, function() return node(C.Sidebar,
      slot(props.sidebar_header, function() return node(C.SidebarHeader, H.h("strong", nil, props.project_name or "Hydronium Lab"), H.h("span", nil, node(C.PreferencesToggle), node(C.SidebarToggle))) end),
      slot(props.story_search, function() return node(C.StorySearch) end),
      slot(props.catalog, function() return node(C.StoryCatalog) end),
      slot(props.inspector, function() return node(C.Inspector,
        H.h("h2", nil, "Selected story"), slot(props.controls, function() return node(C.DefaultControls) end), props.story_controls,
        slot(props.timeline, function() return node(C.Timeline) end), slot(props.interactions, function() return node(C.Interactions) end)) end)) end),
    slot(props.preferences_panel, function() return node(C.Preferences,
      node(C.PreferencesHeader, H.h("strong", nil, "Preferences"), node(C.PreferencesClose)),
      H.h("p", nil, "Saved locally for this project."),
      slot(props.navigation_settings, function() return node(C.NavigationSettings) end),
      slot(props.grid_settings, function() return node(C.GridSettings) end), props.preferences) end), props.children)
end
local exports = { Shell=Shell, Workbench=Shell }
for name, component in pairs(C) do exports[name] = component end
return exports
