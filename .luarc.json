{
  "runtime": {
    "version": "LuaJIT",
    "path": ["?.lua", "?/init.lua", "?.luax"],
    "plugin": "luax/src/hydronium_luax/luals/init.lua"
  },
  "workspace": {
    "library": [
      "core/src",
      "luax/src",
      "luax/types",
      "dom/src",
      "dom/types",
      "dom/ambient-types",
      ".moonstone/env/share/lua/5.1"
    ],
    "checkThirdParty": false,
    "useGitIgnore": false,
    "ignoreDir": [
      ".moonstone/env/bin",
      ".moonstone/env/lib",
      ".moonstone/env/include",
      ".moonstone/env/libexec",
      "zig-cache",
      "zig-out",
      ".git"
    ]
  },
  "files.associations": {
    "*.luax": "lua"
  },
  "plugin": {
    "enable": true,
    "path": "luax/src/hydronium_luax/luals/init.lua"
  },
  "diagnostics": {
    "globals": ["__luax", "__luax_component", "__luax_fragment"]
  },
    "workspace.maxPreload": 10000
}
